# ---- GitHub ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 조직 App installation 인벤토리 조회 전용. 저장소 스캔 토큰과 재사용하지 않는다.
GITHUB_INVENTORY_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
GITHUB_RATE_LIMIT_BUFFER=5
GITHUB_MAX_WAIT_SECONDS=60

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_API_BASE=https://slack.com/api

# ---- Microsoft 365 / Entra ID (읽기 전용 NHI 발견) ----
# 운영에서는 MICROSOFT_CLIENT_SECRET 대신 Workload Identity/인증서 사용 권장.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 이미 발급한 단기 토큰을 사용할 때만 설정. 설정되면 client credentials보다 우선한다.
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_GRAPH_API_BASE=https://graph.microsoft.com/v1.0
MICROSOFT_LOGIN_BASE=https://login.microsoftonline.com

# ---- Google Workspace (OAuth Token 감사 로그 읽기 전용) ----
# admin.reports.audit.readonly Scope의 단기 access token. 운영에서는 별도 토큰 공급자 사용 권장.
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_WORKSPACE_API_BASE=https://admin.googleapis.com

# ---- 추가 SaaS (선택) ----
GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.com/api/v4
NOTION_TOKEN=
NOTION_API_BASE=https://api.notion.com/v1
HUGGINGFACE_TOKEN=
HUGGINGFACE_API_BASE=https://huggingface.co

# ---- 저장소 ----
# 스캔 결과 영속화 DB 경로 (SQLite)
NHI_DB_PATH=nhi_scanner.db
# 운영 PostgreSQL. 비어 있으면 SQLite 를 사용한다.
DATABASE_URL=
# compose.postgres.yml 기본 계정 비밀번호
POSTGRES_PASSWORD=change-me

# ---- Scanner ----
SCANNER_MAX_FILE_SIZE=1048576
SCANNER_CONTEXT_LINES=2
SCANNER_BASE64_ENTROPY=4.5
SCANNER_HEX_ENTROPY=3.0
# 조직별 고유 salt (설정 후 변경하면 기존 Fingerprint 와 대조가 불가능해집니다)
FINGERPRINT_SALT=

# ---- 암호화 Secret material (선택) ----
# URL-safe base64 로 인코딩한 32-byte 키. 운영에서는 KMS/Vault 사용 권장.
# 생성 예: python -c "from security.secret_store import AESGCMSecretMaterialStore as S; print(S.generate_key())"
NHI_MASTER_KEY=
NHI_MASTER_KEY_ID=local-v1
# 검증/조치용 암호문 기본 보관 시간(초)
NHI_SECRET_TTL_SECONDS=3600
# Secret 재검증·조치 승인 API 의 X-NHI-Admin-Key 헤더 값
NHI_ADMIN_API_KEY=

# ---- AI Agent runtime token binding (RFC 9449 DPoP) ----
# 내부 access token 서명용 별도 key(최소 32 bytes). NHI_ADMIN_API_KEY와 재사용하지 않는다.
NHI_RUNTIME_TOKEN_SIGNING_KEY=
NHI_RUNTIME_TOKEN_ISSUER=nhi-agent
NHI_RUNTIME_TOKEN_AUDIENCE=nhi-runtime-api
# nonce 미사용 연구 구현이므로 access token과 proof를 짧게 유지한다.
NHI_RUNTIME_TOKEN_TTL_SECONDS=300
NHI_DPOP_PROOF_MAX_AGE_SECONDS=120
NHI_DPOP_CLOCK_SKEW_SECONDS=30
# reverse proxy 뒤에서는 외부에서 보이는 origin을 명시한다. X-Forwarded-*는 직접 신뢰하지 않는다.
# 예: https://nhi.example.com
NHI_RUNTIME_PUBLIC_BASE_URL=

# ---- HTTP ----
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=3
