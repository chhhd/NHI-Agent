# ---- GitHub ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE=https://api.github.com
GITHUB_API_VERSION=2022-11-28
# 조직 App installation 수집 전용 토큰(조직 Administration read). 저장소 스캔용 GITHUB_TOKEN 과
# 서로 fallback 하지 않는다 — 비어 있으면 /integrations/github/discover 는 네트워크 호출 전에 실패한다.
GITHUB_INVENTORY_TOKEN=
# 조직 Audit Log 읽기 전용 토큰(read:audit_log). 인벤토리·스캔 토큰과 분리한다.
GITHUB_AUDIT_TOKEN=
# Change Control에서 조직 PAT 폐기에만 쓰는 관리자 토큰. 수집 토큰과 분리한다.
GITHUB_CHANGE_TOKEN=
# GitHub App user access token rotation을 사용하는 경우
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
GITHUB_RATE_LIMIT_BUFFER=5
GITHUB_MAX_WAIT_SECONDS=60

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_API_BASE=https://slack.com/api
# Slack token rotation을 사용하는 경우
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

# ---- AWS Change Control ----
# IAM 변경 인증은 boto3 기본 credential chain을 사용한다.
AWS_REGION=ap-northeast-2

# ---- Microsoft 365 / Google Workspace Discovery (읽기 전용, 선택) ----
# Microsoft: Application.Read.All 등 최소 권한. access token 을 직접 주거나 tenant/client 로 발급한다.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_GRAPH_API_BASE=https://graph.microsoft.com/v1.0
MICROSOFT_LOGIN_BASE=https://login.microsoftonline.com
# Google: admin.reports.audit.readonly Scope 의 단기 access token
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_WORKSPACE_API_BASE=https://admin.googleapis.com

# ---- 추가 SaaS (선택) ----
GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.com/api/v4
NOTION_TOKEN=
NOTION_API_BASE=https://api.notion.com/v1
HUGGINGFACE_TOKEN=
HUGGINGFACE_API_BASE=https://huggingface.co

# ---- 저장소 ----
# 스캔 결과 영속화 DB 경로 (SQLite)
NHI_DB_PATH=nhi_scanner.db
# 운영 PostgreSQL. 비어 있으면 SQLite 를 사용한다.
DATABASE_URL=
# compose.postgres.yml 기본 계정 비밀번호
POSTGRES_PASSWORD=change-me

# ---- Scanner ----
SCANNER_MAX_FILE_SIZE=1048576
SCANNER_CONTEXT_LINES=2
SCANNER_BASE64_ENTROPY=4.5
SCANNER_HEX_ENTROPY=3.0
# 조직별 고유 salt (설정 후 변경하면 기존 Fingerprint 와 대조가 불가능해집니다)
FINGERPRINT_SALT=

# ---- 암호화 Secret material (선택) ----
# URL-safe base64 로 인코딩한 32-byte 키. 운영에서는 KMS/Vault 사용 권장.
# 생성 예: python -c "from security.secret_store import AESGCMSecretMaterialStore as S; print(S.generate_key())"
NHI_MASTER_KEY=
NHI_MASTER_KEY_ID=local-v1
# 검증/조치용 암호문 기본 보관 시간(초)
NHI_SECRET_TTL_SECONDS=3600
# Secret 재검증·조치 승인 API 의 X-NHI-Admin-Key 헤더 값
NHI_ADMIN_API_KEY=

# ---- 개인정보보호 / Audit Log 최소화 ----
# strict: actor·IP를 HMAC 가명처리하고 User-Agent 제품군만 저장한다.
NHI_PRIVACY_MODE=strict
# 재시작 후에도 동일 가명으로 상관분석하려면 32바이트 이상 별도 키를 설정한다.
NHI_PRIVACY_PSEUDONYMIZATION_KEY=
# 최소화된 UsageEvent 보존 기간과 "미사용" 판정에 필요한 연속 수집 기간(일)
NHI_USAGE_EVENT_RETENTION_DAYS=30
NHI_USAGE_MIN_COVERAGE_DAYS=30

# ---- HTTP ----
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=3

# ---- Agent API 토큰 탈취·재사용 방어 연구 (DPoP, RFC 9449) ----
# 내부 access token HMAC key. 관리자 키와 다른 32바이트 이상 무작위 값
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NHI_RUNTIME_TOKEN_SIGNING_KEY=
NHI_RUNTIME_TOKEN_ISSUER=nhi-agent
NHI_RUNTIME_TOKEN_AUDIENCE=nhi-runtime-api
NHI_RUNTIME_TOKEN_TTL_SECONDS=300
NHI_DPOP_PROOF_MAX_AGE_SECONDS=120
NHI_DPOP_CLOCK_SKEW_SECONDS=30
# 외부 reverse proxy 뒤의 정규 origin. X-Forwarded-* 는 신뢰하지 않으므로 proxy 뒤에서는 필수
NHI_RUNTIME_PUBLIC_BASE_URL=

# ---- NHI 거버넌스 (실시간 통제 · 변경 승인 · 생명주기) ----
# ALLOW/ALERT: 모든 모드에서 허용(ALERT는 경고). DENY: 모든 모드에서 차단.
# REVIEW: enforce는 차단, monitor는 허용·관찰, human_in_the_loop는 승인 대기·차단.
NHI_CONTROL_MODE=enforce
# 승인 대기 자동 거부 시간 / 승인 후 1회용 허가 유효 시간(초)
NHI_CONTROL_APPROVAL_TTL_SECONDS=900
NHI_CONTROL_GRANT_TTL_SECONDS=300
# 다음 값은 과거 설정 호환용이며 신규 접근 판정은 자동 격리하지 않는다.
NHI_DENY_QUARANTINE_THRESHOLD=3
NHI_DENY_WINDOW_SECONDS=600
# 종료 후 파기 승인을 요청해야 하는 보존 기간(일)
NHI_RETENTION_DAYS=30
NHI_STALE_DAYS=90
NHI_ROTATION_DAYS=90
NHI_EXPIRY_WARNING_DAYS=14
NHI_PERMISSION_OBSERVATION_DAYS=7
# Token 교체 시 이전 Credential 을 유지하는 유예 시간(롤백 가능 시간)
NHI_ROTATION_GRACE_HOURS=24
