# ---- GitHub ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE=https://api.github.com
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
GITHUB_RATE_LIMIT_BUFFER=5
GITHUB_MAX_WAIT_SECONDS=60

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_API_BASE=https://slack.com/api

# ---- 추가 SaaS (선택) ----
GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.com/api/v4
NOTION_TOKEN=
NOTION_API_BASE=https://api.notion.com/v1
HUGGINGFACE_TOKEN=
HUGGINGFACE_API_BASE=https://huggingface.co

# ---- 저장소 ----
# 스캔 결과 영속화 DB 경로 (SQLite)
NHI_DB_PATH=nhi_scanner.db
# 운영 PostgreSQL. 비어 있으면 SQLite 를 사용한다.
DATABASE_URL=
# compose.postgres.yml 기본 계정 비밀번호
POSTGRES_PASSWORD=change-me

# ---- Scanner ----
SCANNER_MAX_FILE_SIZE=1048576
SCANNER_CONTEXT_LINES=2
SCANNER_BASE64_ENTROPY=4.5
SCANNER_HEX_ENTROPY=3.0
# 조직별 고유 salt (설정 후 변경하면 기존 Fingerprint 와 대조가 불가능해집니다)
FINGERPRINT_SALT=

# ---- 암호화 Secret material (선택) ----
# URL-safe base64 로 인코딩한 32-byte 키. 운영에서는 KMS/Vault 사용 권장.
# 생성 예: python -c "from security.secret_store import AESGCMSecretMaterialStore as S; print(S.generate_key())"
NHI_MASTER_KEY=
NHI_MASTER_KEY_ID=local-v1
# 검증/조치용 암호문 기본 보관 시간(초)
NHI_SECRET_TTL_SECONDS=3600
# Secret 재검증·조치 승인 API 의 X-NHI-Admin-Key 헤더 값
NHI_ADMIN_API_KEY=

# ---- HTTP ----
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=3
