# 환경/시크릿
.env
.env.*
!.env.example

# 개인키·인증서·자격 증명 파일 (GitHub App 개인키 등)
*.pem
*.key
*.p12
*.pfx
*.jks
*private-key*
credentials*.json
service-account*.json

# 저장소 DB (감사 로그·분석 결과·암호화 Secret 참조가 들어 있다)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
venv/
.venv/
*.egg-info/

# 로컬 도구 상태 / 팀원 비교용으로 임시로 받아둔 외부 체크아웃(실제 .env·개인
# 토큰이 들어있는 중첩 git 저장소) — 절대 커밋 대상이 아니다.
.omx/
team/

.env
